{
	"$schema": "https://unpkg.com/wrangler@4.125.0/config-schema.json",
	"name": "lunchbox-stats",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	// Requests are not logged: the counter keeps only what migrations/0001_init.sql defines.
	"observability": { "enabled": false },
	"d1_databases": [
		{ "binding": "DB", "database_name": "lunchbox-stats", "database_id": "1c9212e8-eead-4063-a1b9-391a49555133", "migrations_dir": "migrations" }
	]
}
